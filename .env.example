# Axiom — environment variables
# Copy to .env and fill in as needed. See docs/SDD.md for architecture context.

# --- apps/web <-> apps/agent-service ---
# Base URL apps/web uses to reach apps/agent-service (internal, server-side only).
AGENT_SERVICE_URL=http://localhost:8000

# Shared secret sent by apps/web on every internal call to apps/agent-service, and
# validated by agent-service on every request. Header name: X-Axiom-Internal-Secret.
# Generate a random string for local dev, e.g. `openssl rand -hex 32`.
AGENT_SERVICE_SHARED_SECRET=dev-shared-secret-change-me

# --- apps/web (Slice 1+: Postgres via Prisma) ---
# Port 5433 (not the Postgres default 5432) — see docker-compose.yml / docs/DECISIONS.md:
# this dev machine already runs unrelated Postgres instances on 5432.
DATABASE_URL=postgresql://axiom:axiom@localhost:5433/axiom

# --- Slice 1+: Redis / BullMQ background jobs ---
# Port 6380 (not the Redis default 6379) — same reason as above.
REDIS_URL=redis://localhost:6380

# --- apps/agent-service: LLM provider abstraction ---
# LLM_PROVIDER=mock | anthropic | bedrock_strands (auto-detects if unset: bedrock if AWS
# creds present, else anthropic if ANTHROPIC_API_KEY present, else mock)
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# --- Slice 1+: AWS (only needed for the bedrock_strands provider) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_PROFILE=

# --- Live OAuth: Slack + Google (Gmail/Calendar/Drive) integrations ---
# Register a Slack app at https://api.slack.com/apps and a Google OAuth client at
# https://console.cloud.google.com/apis/credentials. Register these OAuth redirect URIs:
#   <origin>/api/integrations/slack/callback
#   <origin>/api/integrations/gmail/callback
#   <origin>/api/integrations/calendar/callback
#   <origin>/api/integrations/drive/callback
# Leave unset to see the "integration not configured" state on /integrations — Connect
# then fails gracefully instead of faking success.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32-byte key (as 64 hex chars, e.g. `openssl rand -hex 32`) used to encrypt OAuth tokens
# at rest (AES-256-GCM) before they're stored on the Integration row. Any non-empty value
# works (falls back to SHA-256 of the raw string) but a real random 32-byte hex key is
# strongly recommended even for local dev, since this key protects real user tokens the
# moment SLACK/GOOGLE credentials above are filled in.
INTEGRATION_TOKEN_KEY=
